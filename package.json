{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local server.ts",
    "build": "next build",
    "start": "tsx --env-file-if-exists=.env.local server.ts",
    "lint": "eslint",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "seed:data": "tsx --env-file-if-exists=.env.local scripts/seed-demo-data.ts",
    "keys": "node scripts/generate-keys.mjs",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@hookform/resolvers": "^7.0.1",
    "@react-pdf/renderer": "^4.9.0",
    "@stripe/stripe-js": "^10.2.1",
    "@tanstack/react-query": "^5.105.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "mongoose": "^9.11.4",
    "motion": "^14.9.0",
    "next": "16.4.4",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/simple-peer": "^9.11.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@auth/core": {
      "nodemailer": "$nodemailer"
    }
  },
  "engines": {
    "node": "26.x"
  }
}
