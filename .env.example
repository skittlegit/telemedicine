# Copy to .env.local. lib/env.ts validates these at startup.
# Generate the three secrets with: npm run keys

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/vellum
NEXTAUTH_SECRET=
PHI_ENCRYPTION_KEY=
PRESCRIPTION_HMAC_KEY=

# Required in production. Used to provision the admin account.
ADMIN_PASSWORD=

# App URLs
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Stripe. Without these, booking and pharmacy orders skip Checkout and auto-confirm.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email. Resend wins if both are set. With neither, emails are logged to stdout.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WebRTC
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Custom server (server.ts)
SOCKET_PATH=/api/socket
PORT=3000

# Storage: local or s3. Use s3 on hosts without a persistent disk.
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Rate limiting. Falls back to in-memory without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# One-shot production seed key for POST /api/admin/bootstrap-seed
BOOTSTRAP_KEY=
